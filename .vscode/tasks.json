{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Correr en el Hub (USB)",
            "type": "shell",
            "command": "pybricksdev",
            "args": ["run", "usb", "${file}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Correr en el Hub (Bluetooth)",
            "type": "shell",
            "command": "pybricksdev",
            "args": ["run", "ble", "${file}"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
